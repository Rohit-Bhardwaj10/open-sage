generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  email         String        @unique
  name          String
  createdAt     DateTime
  updatedAt     DateTime
  emailVerified Boolean
  image         String?
  accounts      Account[]
  repositories  Repository[]
  sessions      Session[]
  chatMessages  ChatMessage[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Repository {
  id            String      @id @default(cuid())
  name          String
  url           String
  userId        String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  cloneError    String?
  cloneStatus   CloneStatus @default(PENDING)
  defaultBranch String?
  description   String?
  indexStatus   IndexStatus @default(PENDING)
  indexError    String?
  totalFiles    Int?
  indexedFiles  Int?
  isPublic      Boolean     @default(true)
  localPath     String?
  user          User        @relation(fields: [userId], references: [id])

  // Relations
  files    IndexedFile[]
  messages ChatMessage[]
}

enum CloneStatus {
  PENDING
  CLONING
  CLONED
  FAILED
}

enum IndexStatus {
  PENDING
  INDEXING
  INDEXED
  FAILED
}

// ── Tracks each indexed file for incremental re-indexing ──────
model IndexedFile {
  id           String     @id @default(cuid())
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  filePath     String // relative path within repo  e.g. "src/utils/auth.ts"
  language     String? // detected language           e.g. "typescript"
  contentHash  String // sha256 of file content — used to skip unchanged files
  fileSize     Int        @default(0)
  chunkCount   Int        @default(0)
  tokenCount   Int        @default(0)
  indexedAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  chunks CodeChunk[]

  @@unique([repositoryId, filePath])
  @@index([repositoryId])
}

// ── Code chunks with vector embeddings for RAG ────────────────
model CodeChunk {
  id     String      @id @default(cuid())
  fileId String
  file   IndexedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  chunkIndex Int // Position in file (0, 1, 2...)
  content    String @db.Text
  startLine  Int
  endLine    Int

  // Vector embedding (768 dimensions for BAAI/bge-base-en-v1.5)
  embedding Unsupported("vector(768)")?

  createdAt DateTime @default(now())

  @@unique([fileId, chunkIndex])
  @@index([fileId])
}

// ── Chat history — one conversation thread per repo per user ──
model ChatMessage {
  id           String      @id @default(cuid())
  repositoryId String
  repository   Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         MessageRole
  content      String      @db.Text
  sources      Json? // [{ file, lineStart, lineEnd, snippet, score }]
  confidence   Float?
  createdAt    DateTime    @default(now())

  @@index([repositoryId, userId])
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}
