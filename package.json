{
  "name": "open-sage-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "opensage",
    "services/*",
    "workers"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=opensage",
    "build": "npm run build --workspace=opensage",
    "start": "npm run start --workspace=opensage",
    "worker:clone": "npm run start:clone --workspace=workers",
    "worker:index": "npm run start:index --workspace=workers",
    "worker:embedding": "npm run start:embedding --workspace=workers",
    "worker:all": "concurrently -k -n clone,index,embed -c blue,green,yellow \"npm run worker:clone\" \"npm run worker:index\" \"npm run worker:embedding\"",
    "queue:check": "tsx scripts/check-queue.ts",
    "queue:clear": "tsx scripts/clear-queue.ts"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "@prisma/client": "^7.4.1",
    "dotenv": "^17.3.1"
  }
}
